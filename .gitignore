# macOS
.DS_Store

# Environment
.env
.env.*
!.env.example

# Node and Bun
node_modules/
.bun/
*.tsbuildinfo

# Build output
dist/
build/
.next/
coverage/

# SQLite runtime files
data/assets/
# Workbench-owned project snapshots: copies of external/owned site source,
# never workbench source. Committing them would vendor third-party pages.
data/projects/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Generated design output
captures/
generated-variants/

# Impeccable ephemeral state
.impeccable/cache/
.impeccable/state/
.impeccable/tmp/


# qmd project-local search index: the database is rebuildable
# and never committed; the allowlist config is tracked.
.qmd/
